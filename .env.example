# ======================================
# Backend Environment
# ======================================

# API keys
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Neo4j (AuraDB / local)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Backend CORS origins (comma-separated)
# Local example:
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production example:
# ALLOWED_ORIGINS=https://your-frontend.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Neo4j tuning
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=30
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_TRANSACTION_RETRY_TIME=30

# Extraction pipeline tuning
EXTRACTION_CONCURRENCY_LIMIT=5
EXTRACTION_BATCH_SIZE=1

# ======================================
# Frontend Environment (Next.js)
# ======================================

# Local backend example:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Production backend example:
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Playwright local overrides
PLAYWRIGHT_FRONTEND_PORT=3000
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
SMOKE_DOCUMENT_ID=doc-transformer
